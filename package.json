{
  "name": "weir",
  "version": "0.1.0",
  "description": "Rules for incoming stablecoin payments. Split to your team and pay yourself first, enforced on-chain. A Nimiq Pay mini app.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "compile": "hardhat compile && node scripts/export-abi.mjs",
    "test": "hardhat test",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "verify": "tsx scripts/verify.mts",
    "export-abi": "node scripts/export-abi.mjs"
  },
  "keywords": [
    "nimiq",
    "mini-app",
    "usdt",
    "payment-splitter",
    "savings"
  ],
  "author": "Oluwasogo \"Israel\" Ajala (Rising Technology)",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-verify": "^2.1.0",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.2",
    "chai": "^4.5.0",
    "dotenv": "^17.4.2",
    "ethers": "^6.15.0",
    "hardhat": "^2.29.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3"
  }
}